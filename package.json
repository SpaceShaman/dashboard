{
  "name": "dashboard-assets",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:css\" \"npm:dev:js\"",
    "dev:css": "tailwindcss -i assets/app.css -o app/static/app.css --watch=always",
    "dev:js": "esbuild assets/app.js --bundle --outfile=app/static/app.js --sourcemap --watch=forever",
    "build:css": "tailwindcss -i assets/app.css -o app/static/app.css --minify",
    "build:js": "esbuild assets/app.js --bundle --minify --outfile=app/static/app.js",
    "build": "concurrently --kill-others-on-fail \"npm:build:css\" \"npm:build:js\""
  },
  "dependencies": {
    "basecoat-css": "1.0.2",
    "htmx.org": "2.0.11",
    "lucide": "1.60.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  }
}
